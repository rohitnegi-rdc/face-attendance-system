{
	"name": "face-attendance-system",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test:e2e:attendance": "playwright test --config=playwright.attendance.config.ts",
		"test:faces": "python scripts/run-face-extraction-suite.py",
		"test:attendance:load": "tsx scripts/run-attendance-concurrency.ts --profile=all",
		"test": "npm run test:e2e",
		"seed": "tsx scripts/seed.ts",
		"migrate": "tsx scripts/migrate.ts",
		"worker": "node worker/index.js"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^24",
		"@types/pg": "^8.11.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.19.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.27.0",
		"bcryptjs": "^2.4.3",
		"csv-parse": "^5.6.0",
		"dayjs": "^1.11.13",
		"exceljs": "^4.4.0",
		"jsonwebtoken": "^9.0.2",
		"pg": "^8.13.1",
		"pino": "^9.5.0",
		"uuid": "^11.0.3"
	}
}
