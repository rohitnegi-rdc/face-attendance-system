# Generate each independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=6100
# Postgres on the host loopback only (127.0.0.1). Containers reach it as postgres:5432.
DB_HOST_PORT=6101
APP_IMAGE=face-attendance/app:local
# URL prefix when served under a sub-path behind nginx, e.g. BASE_PATH=/pump-attendance for
# https://ops.rdcc.ai/pump-attendance. Leave empty to serve from the domain root. Baked in at
# build time: changing it needs a rebuild (docker compose up -d --build). If set, include it in
# GOOGLE_OAUTH_REDIRECT_URI too, e.g. https://ops.rdcc.ai/pump-attendance/api/auth/google/callback
BASE_PATH=
# Only for plain-http access with no HTTPS proxy in front (local runs): the exact URL you open,
# e.g. http://localhost:6100. Leave unset in production; nginx sends x-forwarded-proto. Without
# it, local photo uploads fail the CSRF check with 403.
# ORIGIN=http://localhost:6100
DATABASE_URL=postgres://attendance:<POSTGRES_PASSWORD>@localhost:6101/attendance
# Optional until Google Workspace OAuth is configured for the deployment hostname.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:6100/api/auth/google/callback
# Face match threshold (cosine similarity). 0.28 is the best value in the golden small-group
# evaluation (zero false matches, 98.3% attendance accuracy). See src/lib/server/matching.ts.
FACE_MATCH_THRESHOLD=0.28
# Shift start/end timing. Admin can override both at /admin/settings (that wins over these).
# Shift end (and the pump End session button) opens this many minutes after the start (540 = 9 h).
EVENING_MIN_GAP_MINUTES=540
# An open shift start with no end is auto-closed as "start only" after this many hours.
EVENING_PAIRING_WINDOW_HOURS=24
# Test mode: true lets an admin switch off the cross-pump fraud check at /admin/settings, to test
# with the same people at several pumps. Keep false for real attendance; then the check always runs.
TEST_MODE=false
# AI service (face detection, embeddings and anti-spoofing) on the host loopback, for the
# face evaluation scripts. The app and worker containers use http://ai-service:8000 instead.
AI_HOST_PORT=6102
AI_SERVICE_URL=http://localhost:6102
UPLOAD_DIR=./uploads
# Falsified-photo (screen/print) detection. Off for v1. To turn it back on, set both to true:
# ANTI_SPOOF_ENABLED runs the spoof model in ai-service, PHOTO_SPOOF_CHECK_ENABLED lets the
# worker block the pump on a fake photo. The cross-pump Area check is always on (unless an admin
# switches it off in test mode, see TEST_MODE).
ANTI_SPOOF_ENABLED=false
PHOTO_SPOOF_CHECK_ENABLED=false
ANTI_SPOOF_LIVE_THRESHOLD=0.80
ANTI_SPOOF_SUSPICIOUS_THRESHOLD=0.20
ANTI_SPOOF_MIN_FACE_SIZE=64
PORT=3000
# Fraud alert email (sent to the plant manager on file when a fake photo is detected).
# Leave SMTP_HOST blank to disable — the worker logs and skips sending instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Always CC'd on every fraud alert in addition to the plant manager.
FRAUD_ALERT_CC_EMAIL=
# The same SMTP settings send location approval emails (shift start held) to plant managers.
# Email is sent only when MAIL_ENABLED=true. Set it on the production server only; locally
# every mail (password reset, location approval, fraud alert) is written to the log instead.
MAIL_ENABLED=false

# Pump GPS for the location check, read only from the optimizer database (dump.pump_events).
# Leave the user empty to turn it off. Host and port default to the optimizer's published port.
POSTGRES_USER_PUMPDB=
POSTGRES_PASSWORD_PUMPDB=
POSTGRES_DB_PUMPDB=
# PUMP_GPS_DB_HOST=host.docker.internal
# PUMP_GPS_DB_PORT=7432
# PUMP_GPS_POLL_MINUTES=5

# Gemini screen/print recapture check (worker). Leave the key empty to disable it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Block the pump only when Gemini says recapture with at least this confidence (0-1).
RECAPTURE_BLOCK_CONFIDENCE=0.85
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TIMEOUT_SECONDS=20
ATTENDANCE_QUEUE_LAG_LIMIT_SECONDS=300

# Days the admin Logs page (/admin/logs) keeps warnings and errors. The worker removes older
# lines hourly.
LOG_RETENTION_DAYS=30
