# Generate each independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=3001
APP_IMAGE=face-attendance/app:local
DATABASE_URL=postgres://attendance:<POSTGRES_PASSWORD>@localhost:5434/attendance
# Optional until Google Workspace OAuth is configured for the deployment hostname.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FACE_MATCH_THRESHOLD=0.30
EVENING_PAIRING_WINDOW_HOURS=24
AI_SERVICE_URL=http://localhost:8000
UPLOAD_DIR=./uploads
ANTI_SPOOF_ENABLED=true
ANTI_SPOOF_LIVE_THRESHOLD=0.80
ANTI_SPOOF_SUSPICIOUS_THRESHOLD=0.80
ANTI_SPOOF_MIN_FACE_SIZE=64
PORT=3000
# Fraud alert email (sent to the plant manager on file when a fake photo is detected).
# Leave SMTP_HOST blank to disable — the worker logs and skips sending instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Always CC'd on every fraud alert in addition to the plant manager.
FRAUD_ALERT_CC_EMAIL=

# Gemini screen/print recapture check (worker). Leave the key empty to disable it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Block the pump only when Gemini says recapture with at least this confidence (0-1).
RECAPTURE_BLOCK_CONFIDENCE=0.85
